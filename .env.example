DEEPSEEK_API_KEY=sk-...
DATA_SOURCE=yfinance
DATA_SOURCE_A=yfinance
# 本机程序运行时自动更新。设为 0 则只在点击更新按钮时采集。
STOCK_AGENT_AUTO_REFRESH=1
# 可选：数据库文件位置；默认 data/stock-agent.sqlite3
# STOCK_AGENT_DB=D:/path/to/stock-agent.sqlite3
# A 股独立数据库；默认与港股数据库同目录的 stock-agent-a.sqlite3
# STOCK_AGENT_A_DB=D:/path/to/stock-agent-a.sqlite3
